{
  "name": "@kong/stylelint-plugin-design-tokens",
  "version": "2.0.1",
  "type": "module",
  "description": "Stylelint plugin for Kong UI design tokens",
  "exports": {
    ".": "./index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "rules",
    "utilities",
    "README.md",
    "!**/*.spec.mjs"
  ],
  "scripts": {
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.mjs"
  },
  "peerDependencies": {
    "stylelint": ">=14.0.0"
  },
  "devDependencies": {
    "postcss-scss": "^4.0.9",
    "vitest": "^4.1.9"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Kong/design-tokens.git"
  },
  "homepage": "https://github.com/Kong/design-tokens/packages/stylelint-plugin-design-tokens/",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.19.5",
    "pnpm": ">=10.34.5"
  }
}
