{
  "name": "@kong/design-tokens-monorepo",
  "private": true,
  "scripts": {
    "build": "FORCE_COLOR=1 pnpm -r build",
    "lint": "FORCE_COLOR=1 pnpm -r --if-present lint",
    "lint:fix": "FORCE_COLOR=1 pnpm -r --if-present lint:fix",
    "stylelint": "FORCE_COLOR=1 pnpm -r --if-present stylelint",
    "stylelint:fix": "FORCE_COLOR=1 pnpm -r --if-present stylelint:fix",
    "typecheck": "FORCE_COLOR=1 pnpm -r --if-present typecheck",
    "test": "FORCE_COLOR=1 pnpm -r --if-present --reporter append-only test",
    "sandbox:design-tokens": "FORCE_COLOR=1 pnpm --filter @kong/design-tokens sandbox",
    "sandbox:design-tokens:build": "FORCE_COLOR=1 pnpm --filter @kong/design-tokens sandbox:build",
    "commit": "cz"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@digitalroute/cz-conventional-changelog-for-jira": "^8.0.1",
    "@evilmartians/lefthook": "^2.1.9",
    "@kong/eslint-config-kong-ui": "^1.7.1",
    "@lerna-lite/changed": "^5.2.2",
    "@lerna-lite/cli": "^5.2.2",
    "@lerna-lite/list": "^5.2.2",
    "@lerna-lite/publish": "^5.2.2",
    "@lerna-lite/version": "^5.2.2",
    "@stylistic/stylelint-plugin": "^5.2.1",
    "@typescript-eslint/parser": "^8.59.4",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "chokidar-cli": "^3.0.0",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.9.2",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^9.0.3",
    "rimraf": "^6.1.3",
    "sass": "^1.97.3",
    "shx": "^0.4.0",
    "style-dictionary": "^5.4.4",
    "stylelint": "^17.14.0",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-order": "^8.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-restart": "^2.0.0",
    "vite-plugin-vue-devtools": "^8.0.7",
    "vitest": "^4.1.9",
    "vue": "^3.5.39",
    "vue-eslint-parser": "^10.4.1",
    "vue-router": "^5.1.0",
    "vue-tsc": "^3.3.5"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/@digitalroute/cz-conventional-changelog-for-jira",
      "skipScope": false,
      "jiraOptional": true,
      "jiraLocation": "post-description",
      "jiraPrepend": "[",
      "jiraAppend": "]"
    }
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20.19.5",
    "pnpm": ">=10.28.2 || >=11.9.0"
  },
  "volta": {
    "node": "24.13.1"
  }
}
